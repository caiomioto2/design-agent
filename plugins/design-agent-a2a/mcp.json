{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "design-agent": {
      "type": "stdio",
      "command": "uv",
      "env": {"UV_PROJECT_ENVIRONMENT": "${PLUGIN_ROOT}/.venv"},
      "args": ["run", "--frozen", "--project", "${PLUGIN_ROOT}", "python", "${PLUGIN_ROOT}/server.py", "mcp"]
    }
  }
}
